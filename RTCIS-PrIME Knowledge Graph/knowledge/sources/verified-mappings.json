  "join_paths": {
    "ORDDTL->TRUKIO": {
      "rtcis_join": "ORDDTL.ORDNUM = TRUKIO.ORDNUM",
      "direct_possible": false,
      "verified": "2026-03-30",
      "reason": "Expert confirmed: trlr (NOT trlr). trlr has no ordnum ->requires 5-hop via shipment bridge. APTDAT from appt table (trlr.appt_id = appt.appt_id).",
      "prime_path": [
        {
          "from": "ord_line",
          "to": "shipment_line",
          "on": "ordnum + ordlin",
          "note": "shipment_line PK is ship_line_id; ordnum+ordlin are FK to ord_line"
        },
        {
          "from": "shipment_line",
          "to": "shipment",
          "on": "ship_id"
        },
        {
          "from": "shipment",
          "to": "stop",
          "on": "stop_id",
          "note": "shipment has stop_id but NOT trlr_id"
        },
        {
          "from": "stop",
          "to": "car_move",
          "on": "car_move_id",
          "note": "stop has car_move_id (Load ID)"
        },
        {
          "from": "car_move",
          "to": "trlr",
          "on": "trlr_id",
          "note": "Expert: car_move.trlr_id -> trlr (NOT trlr). trlr.appt_id -> appt for APTDAT"
        }
      ],
      "prime_sql": "FROM dbo.ord_line d\nJOIN dbo.shipment_line sl ON d.ordnum = sl.ordnum AND d.ordlin = sl.ordlin AND d.client_id = sl.client_id\nJOIN dbo.shipment s ON sl.ship_id = s.ship_id\nJOIN dbo.stop st ON s.stop_id = st.stop_id\nJOIN dbo.car_move cm ON st.car_move_id = cm.car_move_id\nJOIN dbo.trlr t ON cm.trlr_id = t.trlr_id\nLEFT JOIN dbo.appt ap ON t.appt_id = ap.appt_id",
      "hops": 5,
      "verified_via": "prime-datamodel.json (shipment.trlr_id=NOT_FOUND, shipment.stop_id=FOUND, stop.car_move_id=FOUND, car_move.trlr_id=FOUND)"
    },
    "ORDDTL->ORDHDR": {
      "rtcis_join": "ORDDTL.ORDNUM = ORDHDR.ORDNUM",
      "direct_possible": true,
      "prime_join": "ord_line.ordnum = ord.ordnum"
    },
    "ORDHDR->SHPHDR": {
      "rtcis_join": "ORDHDR.SHIPID = SHPHDR.SHIPID",
      "direct_possible": true,
      "prime_join": "ord.ship_id = shipment.ship_id"
    },
    "SHPHDR->SHPORD": {
      "rtcis_join": "SHPHDR.SHIPID = SHPORD.SHIPID",
      "direct_possible": true,
      "prime_join": "shipment.ship_id = shipment_line.ship_id"
    },
    "RCPHDR->RCPDTL": {
      "rtcis_join": "RCPHDR.RCPNUM = RCPDTL.RCPNUM",
      "direct_possible": true,
      "prime_join": "rcvinv.trknum = rcvlin.trknum",
      "notes": "Receipt number ->tracking number in PrIME"
    },
    "INVACT->LOCATN": {
      "rtcis_join": "INVACT.LOCATN = LOCATN.LOCATN",
      "direct_possible": true,
      "prime_join": "invmov.dstloc = locmst.stoloc",
      "notes": "Or from_loc depending on direction"
    },
    "SYSTRN->SYSDTL": {
      "rtcis_join": "SYSTRN.TRNSEQ = SYSDTL.TRNSEQ",
      "direct_possible": false,
      "verified": "2026-03-26",
      "reason": "Both SYSTRN and SYSDTL map to dlytrn (denormalized). The JOIN becomes unnecessary in PrIME.",
      "prime_join": "N/A ->both tables merge into dlytrn",
      "prime_sql": "SELECT * FROM dbo.dlytrn",
      "notes": "[!] SYSTRN (header) + SYSDTL (detail) are flattened into one dlytrn record in PrIME. Verify cardinality matches."
    },
    "SYSDTL->LOCATN": {
      "rtcis_join": "SYSDTL.LOCATN = LOCATN.LOCATN",
      "direct_possible": true,
      "verified": "2026-03-26",
      "prime_join": "dlytrn.frstol = locmst.stoloc AND dlytrn.wh_id = locmst.wh_id",
      "notes": "[!] dlytrn has frstol (from) and tostol (to). Use frstol as default; verify which matches SYSDTL.LOCATN intent"
    },
    "ITEM_CONFIG->ITEM_UOM": {
      "rtcis_join": "ITEM_CONFIG.ITMCOD = ITEM_UOM.ITMCOD",
      "direct_possible": true,
      "verified": "2026-03-26",
      "prime_join": "prtmst.prtnum = prtftp_dtl.prtnum AND prtmst.prt_client_id = prtftp_dtl.prt_client_id",
      "notes": "prtftp_dtl may return multiple rows per item (different UOMs/footprints)"
    }
  },
