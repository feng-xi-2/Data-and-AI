# PrIME Config Drift alert — environment variables
# Copy to a .env or set in your shell before running. NEVER commit real secrets.

# --- Which source to read drift from: "excel" (default, offline) or "pbi" (live) ---
DRIFT_SOURCE=excel

# --- Excel source (default) --------------------------------------------------
# Leave BLANK to use the shipped Config report/data.xlsx (auto-resolved). Only set
# this to point at a refreshed export kept somewhere else.
DRIFT_EXCEL_PATH=

# --- Live Power BI source (only needed when DRIFT_SOURCE=pbi) -----------------
# Dataset GUID taken from the .xlsx connection; override if it changes.
PBI_DATASET_ID=c44ded54-cd3c-489f-a0f4-05cad31d2ea4
# Optional workspace (group) GUID if the dataset is in a specific workspace.
PBI_GROUP_ID=
PBI_TENANT_ID=3596192b-fdf5-4e2c-a6fa-acb706c963d8
PBI_CLIENT_ID=1950a258-227b-4e31-a9cf-717495945fc2

# --- Teams alert (Incoming Webhook URL for the target channel) ---------------
TEAMS_WEBHOOK=

# --- Email alert (SMTP relay) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=25
SMTP_SENDER=drift-alerts@pg.com
# comma-separated recipients
SMTP_TO=you@pg.com
